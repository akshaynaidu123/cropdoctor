# Backend credentials only. Never use a VITE_ prefix for the key.
GEMINI_API_KEY=your_gemini_api_key_here
# Choose an image + structured-output model available to your AI Studio project.
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=5000
HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Used by dev:frontend/preview; npm run dev connects its own API automatically.
API_PROXY_TARGET=http://127.0.0.1:5000
